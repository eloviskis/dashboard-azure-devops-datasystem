# ─────────────────────────────────────────────────────────────────────────────
# DevOps Dashboard — Backend Configuration Template
# Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/devops_dashboard

# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=substitua-por-string-aleatoria-longa

# ── Azure DevOps ──────────────────────────────────────────────────────────────
AZURE_ORG=nome-da-organizacao
AZURE_PROJECT=nome-do-projeto
# PAT: Azure DevOps → User Settings → Personal Access Tokens → New Token
# Permissões mínimas: Work Items (Read), Code (Read), Graph (Read)
AZURE_PAT=seu-personal-access-token

# ── Porta do servidor ─────────────────────────────────────────────────────────
PORT=3001

# ── CORS: origens permitidas (vírgula para múltiplas) ────────────────────────
# Ex: ALLOWED_ORIGIN=https://meudominio.com,http://200.10.20.30
ALLOWED_ORIGIN=http://SEU_IP_OU_DOMINIO

# ── Senha inicial do admin ───────────────────────────────────────────────────
# Criado automaticamente no primeiro startup se não existir usuário admin
ADMIN_DEFAULT_PASSWORD=troque-esta-senha

# ── Microsoft Graph (Calendário/Cerimônias) — OPCIONAL ───────────────────────
# Deixe em branco se não usar a funcionalidade de calendário
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_USER_EMAIL=
GRAPH_REDIRECT_URI=https://SEU_DOMINIO/api/ceremonies/auth/callback
