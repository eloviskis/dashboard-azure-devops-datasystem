# Azure DevOps Configuration
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_PAT=your-personal-access-token-here

# Security (REQUIRED)
JWT_SECRET=generate-a-strong-random-secret-here
ADMIN_DEFAULT_PASSWORD=set-a-strong-admin-password

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname

# Server Configuration
PORT=3001

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificacoes@seudominio.com
FRONTEND_URL=http://localhost:5173

# Narrativa de IA no resumo semanal (Gemini — opcional, mesma chave do Google AI Studio usada no frontend)
GEMINI_API_KEY=
